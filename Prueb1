#include <iostream>
#include <string>
using namespace std;

#define MAX_CLIENTES 100
#define HORARIOS 5


string leerNombre(string mensaje)
{
    string nombre;

    do
    {
        cout << mensaje;
        getline(cin, nombre);

        if (nombre.empty())
        {
            cout << "ERROR: nombre vacio.\n";
        }

    } while (nombre.empty());

    return nombre;
}

// Arreglos de clientes
int codigos[MAX_CLIENTES];
int edades[MAX_CLIENTES];
int membresias[MAX_CLIENTES]; // 1: Básica, 2: Premium, 3: VIP
int asistencias[MAX_CLIENTES];

int totalClientes = 0;

// Matriz de horarios
// columna 0 = horario
// columna 1 = capacidad
// columna 2 = asistencias registradas
int matrizHorarios[HORARIOS][3] = {
    {6,  10, 0},
    {8,  10, 0},
    {10, 10, 0},
    {18, 10, 0},
    {20, 10, 0}
};

void registrarCliente()
{
    if (totalClientes >= MAX_CLIENTES)
    {
        cout << "No se pueden registrar mas clientes.\n";
        return;
    }

    cout << "\n--- REGISTRO DE CLIENTE ---\n";

    cout << "Ingrese codigo del cliente: ";
    cin >> codigos[totalClientes];

    cout << "Ingrese edad: ";
    cin >> edades[totalClientes];

    cout << "Tipo de membresia\n";
    cout << "1. Basica\n";
    cout << "2. Premium\n";
    cout << "3. VIP\n";
    cout << "Ingrese opcion: ";
    cin >> membresias[totalClientes];

    asistencias[totalClientes] = 0;

    totalClientes++;

    cout << "Cliente registrado correctamente.\n";
}

void listarHorarios()
{
    cout << "\n--- HORARIOS DISPONIBLES ---\n";
    cout << "Nro\tHorario\tCapacidad\tAsistencias\n";

    for (int i = 0; i < HORARIOS; i++)
    {
        cout << i + 1 << "\t"
            << matrizHorarios[i][0] << ":00\t"
            << matrizHorarios[i][1] << "\t\t"
            << matrizHorarios[i][2] << endl;
    }
}

int buscarCliente(int codigo)
{
    for (int i = 0; i < totalClientes; i++)
    {
        if (codigos[i] == codigo)
        {
            return i;
        }
    }
    return -1;
}

void registrarAsistencia()
{
    int codigo, posCliente, opcionHorario;

    cout << "\n--- REGISTRO DE ASISTENCIA ---\n";
    cout << "Ingrese codigo del cliente: ";
    cin >> codigo;

    posCliente = buscarCliente(codigo);

    if (posCliente == -1)
    {
        cout << "Cliente no encontrado.\n";
        return;
    }

    listarHorarios();

    cout << "Seleccione horario: ";
    cin >> opcionHorario;

    opcionHorario--;

    if (opcionHorario < 0 || opcionHorario >= HORARIOS)
    {
        cout << "Horario invalido.\n";
        return;
    }

    if (matrizHorarios[opcionHorario][2] >= matrizHorarios[opcionHorario][1])
    {
        cout << "El horario ya no tiene capacidad disponible.\n";
        return;
    }

    asistencias[posCliente]++;
    matrizHorarios[opcionHorario][2]++;

    cout << "Asistencia registrada correctamente.\n";
}

void controlarAforo()
{
    cout << "\n--- CONTROL DE AFORO ---\n";

    for (int i = 0; i < HORARIOS; i++)
    {
        cout << "Horario " << matrizHorarios[i][0] << ":00 -> ";

        if (matrizHorarios[i][2] >= matrizHorarios[i][1])
        {
            cout << "AFORO COMPLETO\n";
        }
        else
        {
            cout << "Disponible: "
                << matrizHorarios[i][1] - matrizHorarios[i][2]
                << " cupos\n";
        }
    }
}

void horarioMasConcurrido()
{
    int mayor = matrizHorarios[0][2];
    int posMayor = 0;

    for (int i = 1; i < HORARIOS; i++)
    {
        if (matrizHorarios[i][2] > mayor)
        {
            mayor = matrizHorarios[i][2];
            posMayor = i;
        }
    }

    cout << "\n--- HORARIO MAS CONCURRIDO ---\n";
    cout << "Horario: " << matrizHorarios[posMayor][0] << ":00\n";
    cout << "Asistencias: " << mayor << endl;
}

void clientesActivos()
{
    int activos = 0;

    for (int i = 0; i < totalClientes; i++)
    {
        if (asistencias[i] > 0)
        {
            activos++;
        }
    }

    cout << "\nClientes activos: " << activos << endl;
}

void promedioAsistencia()
{
    int suma = 0;
    float promedio;

    if (totalClientes == 0)
    {
        cout << "No hay clientes registrados.\n";
        return;
    }

    for (int i = 0; i < totalClientes; i++)
    {
        suma += asistencias[i];
    }

    promedio = (float)suma / totalClientes;

    cout << "\nPromedio de asistencia por cliente: " << promedio << endl;
}

void reporteClientes()
{
    cout << "\n--- TOTAL CLIENTES ---\n";
    cout << "Total registrados: " << totalClientes << endl;
}

void reporteAsistenciaDiaria()
{
    int total = 0;

    for (int i = 0; i < HORARIOS; i++)
    {
        total += matrizHorarios[i][2];
    }

    cout << "\nAsistencia diaria total: " << total << endl;
}

int main()
{
    int opcion;

    do
    {
        cout << "\n===== SISTEMA DE CONTROL DE GIMNASIO =====\n";
        cout << "1. Registrar cliente\n";
        cout << "2. Ver horarios disponibles\n";
        cout << "3. Registrar asistencia\n";
        cout << "4. Control de aforo\n";
        cout << "5. Horario mas concurrido\n";
        cout << "6. Clientes activos\n";
        cout << "7. Promedio de asistencia\n";
        cout << "8. Reporte asistencia diaria\n";
        cout << "9. Total clientes\n";
        cout << "0. Salir\n";
        cout << "Ingrese opcion: ";
        cin >> opcion;

        switch (opcion)
        {
        case 1:
            registrarCliente();
            break;
        case 2:
            listarHorarios();
            break;
        case 3:
            registrarAsistencia();
            break;
        case 4:
            controlarAforo();
            break;
        case 5:
            horarioMasConcurrido();
            break;
        case 6:
            clientesActivos();
            break;
        case 7:
            promedioAsistencia();
            break;
        case 8:
            reporteAsistenciaDiaria();
            break;
        case 9:
            reporteClientes();
            break;
        case 0:
            cout << "Saliendo del sistema...\n";
            break;
        default:
            cout << "Opcion invalida.\n";
        }

    } while (opcion != 0);

    return 0;
}
